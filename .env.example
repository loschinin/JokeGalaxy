# Copy to .env and replace every placeholder before deployment.
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://jokegalaxy:replace-me@localhost:5432/jokegalaxy?sslmode=disable
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
SITE_URL=http://localhost:8080
FRONTEND_DIST=../frontend/dist

# Yandex ID OAuth application; callback URL must be registered in Yandex OAuth settings.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Yandex Foundation Models embeddings (text-search-doc/query, 256 dimensions).
YANDEX_FOLDER_ID=
YANDEX_API_KEY=

# DeepSeek text analysis and streaming monologue generation.
DEEPSEEK_API_KEY=

# YooKassa merchant credentials; webhook: {SITE_URL}/api/payments/webhook
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
